{
  "version": 1,
  "formatters": {
    "default": {
      "format": "%(processName)s|%(process)d|%(asctime)s|%(filename)s|%(lineno)d|%(funcName)s|%(levelname)s|%(message)s"
    }
  },
  "handlers": {
    "file": {
      "class": "logging.FileHandler",
      "formatter": "default",
      "filename": "/mnt/yrfs/users/like/package/sglang/temp/vllm.log",
      "mode": "a"
    },
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stdout"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["file", "console"]
  }
}
