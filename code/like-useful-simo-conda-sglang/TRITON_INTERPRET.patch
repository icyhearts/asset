--- a/simo/ops/kernels/upcast/_upcast_from_mxfmt.py
+++ b/simo/ops/kernels/upcast/_upcast_from_mxfmt.py
@@ -147,81 +147,81 @@ def _unpack_and_dequant_mxfmt(
     else:  # MXINT8
       mx_tensor = mx_tensor.to(tl.int8, bitcast=True)
     dst_tensor = mx_tensor.to(out_dtype)
     # This logic is specific to upcasting from E5M2 to a wider format.
     if MX_FORMAT_ID == MXFP8_E5M2:
       from_e_bits, from_m_bits = 5, 2
       to_e_bits = 8 if out_dtype == tl.bfloat16 else 5
       to_m_bits = 7 if out_dtype == tl.bfloat16 else 10
       non_finite_mask_src = ((1 << from_e_bits) - 1) << from_m_bits
       non_finite_mask_dst = ((1 << to_e_bits) - 1) << to_m_bits
 
       # The result of the bitwise OR is promoted to int32. We must cast it back
       # to uint16 before the final bitcast to the target float type.
       upcasted_non_finite = dst_tensor.to(tl.uint16, bitcast=True) | non_finite_mask_dst
       upcasted_non_finite = upcasted_non_finite.to(tl.uint16)
       upcasted_non_finite = upcasted_non_finite.to(out_dtype, bitcast=True)
 
       dst_tensor = tl.where(
         (mx_tensor.to(tl.uint8, bitcast=True) & non_finite_mask_src) == non_finite_mask_src,
         upcasted_non_finite,
         dst_tensor,
       )
 
   # --- Dequantize by Applying Scale ---
   # Upcast the scale to the destination type.
   if scale.dtype == tl.uint8:
     if out_dtype == tl.bfloat16:
       dst_scale = (scale.to(tl.uint16) << 7).to(out_dtype, bitcast=True)
     else:
       dst_scale = (scale.to(tl.uint32) << 23).to(tl.float32, bitcast=True)
       dst_scale = dst_scale.to(tl.float16)
   elif scale.dtype == tl.float8e4nv:
     dst_scale = scale.to(out_dtype)
 
   # Reshape for proper broadcasting
   dst_tensor = dst_tensor.reshape([BLOCK_SIZE_OUT_DIM, BLOCK_SIZE_QUANT_MX_SCALE, MX_QUANT_DIM])
   dst_scale = dst_scale.reshape([BLOCK_SIZE_OUT_DIM, BLOCK_SIZE_QUANT_MX_SCALE, 1])
 
   # Apply INT scaling adjustments
   if MX_FORMAT_ID == MXINT8:
-    dst_scale = dst_scale * 2 ** (-6.0)
+    dst_scale = dst_scale * tl.cast(2 ** (-6.0), dst_scale.dtype) # dst_scale = dst_scale * 2 ** (-6.0)
   elif MX_FORMAT_ID == MXINT4:
     dst_scale = dst_scale * 2 ** (-2.0)
 
   # Apply scale and handle NaNs
   out_tensor = dst_tensor * dst_scale
   if out_dtype == tl.float32:
     out_tensor = out_tensor.to(tl.float32)
   # out_tensor = tl.where(scale == 0xFF, float("nan"), out_tensor)
   out_tensor = out_tensor.reshape([BLOCK_SIZE_OUT_DIM, BLOCK_SIZE_QUANT_DIM])
 
   return out_tensor
 
 
